<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - ThriftShop | Website Mua Bán Đồ Cũ Secondhand</title>
    <!-- Fonts (Be Vietnam Pro: Chuẩn font tiếng Việt không bị nhảy nét / lệch dấu) -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Be+Vietnam+Pro:wght@400;500;600;700;800&display=swap" rel="stylesheet">
    <style>
        body, h1, h2, h3, h4, h5, h6, input, button, select, textarea, a, span, p, div {
            font-family: 'Be Vietnam Pro', -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif !important;
        }
    </style>
    <!-- Font Awesome -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" />
    <!-- Page Transition -->
    <link rel="stylesheet" href="~/css/page-transition.css" asp-append-version="true" />
    <!-- Custom Style (WebApplication8 aesthetic) -->
    <link rel="stylesheet" href="~/css/style.css" asp-append-version="true" />
</head>
<body>
    <!-- HEADER CHUẨN CAMERA917 -->
    <header>
        <div class="top-bar">
            <!-- Brand Logo -->
            <div class="logo">
                <a asp-controller="Home" asp-action="Index">Thrift<span>Shop</span></a>
            </div>

            <!-- Search Bar -->
            <div class="search">
                <form id="globalSearchForm" method="get" action="/" class="search-form search-bar-wrapper">
                    <input type="text" id="globalSearchInput" name="search" 
                           value="@Context.Request.Query["search"]"
                           placeholder="Tìm kiếm đồ cũ: quần áo vintage, công nghệ, giày dép, sách cũ..." 
                           autocomplete="off" />
                    @if (!string.IsNullOrEmpty(Context.Request.Query["search"]))
                    {
                        <a href="/" id="clearSearchBtn" title="Xóa tìm kiếm" style="position: absolute; right: 46px; top: 50%; transform: translateY(-50%); text-decoration: none; cursor: pointer; color: #9ca3af; font-size: 15px; font-weight: bold; padding: 4px; z-index: 2;">✕</a>
                    }
                    <button type="submit" id="btnGlobalSearch" style="position: absolute; right: 18px; top: 50%; transform: translateY(-50%); background: none; border: none; cursor: pointer; font-size: 18px;" aria-label="Tìm kiếm">
                        🔍
                    </button>
                </form>
            </div>

            <!-- User Actions -->
            <div class="user">
                <!-- Người dùng & Tài khoản: RENDER TỪ COOKIE AUTH & SERVER SESSION -->
                @{
                    bool isUserLoggedIn = (User.Identity != null && User.Identity.IsAuthenticated) || Context.Session.IsLoggedIn();
                    string displayName = Context.Session.GetUserName() ?? User.Identity?.Name ?? "Thành viên";
                    string displayAvatar = Context.Session.GetUserAvatar() ?? User.FindFirst("Avatar")?.Value ?? "https://images.unsplash.com/photo-1535713875002-d1d0cf377fde?w=150";
                    bool isUserAdmin = User.IsInRole("admin") || (User.FindFirst(System.Security.Claims.ClaimTypes.Email)?.Value == "admin@thriftshop.vn") || Context.Session.IsAdmin();
                }
                <div id="user-header-auth" style="display: inline-flex; align-items: center; gap: 12px;">
                    @if (isUserLoggedIn)
                    {
                        <div class="dropdown" style="position: relative; display: inline-block;">
                            <button class="btn btn-link dropdown-toggle text-white d-flex align-items-center no-transition" type="button" id="userMenuBtn" data-toggle="dropdown" aria-haspopup="true" aria-expanded="false" style="text-decoration: none; box-shadow: none; padding: 4px 8px; border: none; background: transparent;">
                                <img src="@displayAvatar" style="width: 34px; height: 34px; border-radius: 50%; object-fit: cover; border: 2px solid #ff3c00; margin-right: 8px;">
                                <span style="color: #ffffff !important; font-weight: 600; font-size: 14px;">@displayName</span>
                            </button>
                            <div class="dropdown-menu dropdown-menu-right shadow border-0" aria-labelledby="userMenuBtn" style="border-radius: 10px; margin-top: 8px; z-index: 1050; min-width: 200px;">
                                <a class="dropdown-item no-transition" asp-controller="Orders" asp-action="MyOrders"><i class="fas fa-receipt mr-2 text-success"></i>Đơn hàng của tôi</a>
                                <a class="dropdown-item no-transition" asp-controller="Products" asp-action="MyListings"><i class="fas fa-list-alt mr-2 text-primary"></i>Tin của tôi</a>
                                <a class="dropdown-item no-transition" asp-controller="Account" asp-action="Profile"><i class="fas fa-user-cog mr-2 text-secondary"></i>Cài đặt tài khoản</a>
                                <a class="dropdown-item no-transition" asp-controller="Products" asp-action="Favorites"><i class="fas fa-heart mr-2 text-danger"></i>Tin đã yêu thích</a>
                                @if (isUserAdmin)
                                {
                                    <div class="dropdown-divider"></div>
                                    <a class="dropdown-item text-warning font-weight-bold" asp-controller="Admin" asp-action="Index">
                                        <i class="fas fa-user-shield mr-2"></i>Trang Quản Trị (Admin)
                                    </a>
                                }
                                <div class="dropdown-divider"></div>
                                <a class="dropdown-item text-danger" asp-controller="Account" asp-action="Logout"><i class="fas fa-sign-out-alt mr-2"></i>Đăng xuất</a>
                            </div>
                        </div>
                    }
                    else
                    {
                        <a asp-controller="Account" asp-action="Login" style="color: #ffffff; text-decoration: none; font-weight: 600; margin-right: 8px;">Đăng nhập</a>
                        <a asp-controller="Account" asp-action="Register" class="btn btn-sm btn-outline-light font-weight-bold" style="border-radius: 20px; padding: 4px 14px;">Đăng ký</a>
                    }
                </div>

                <!-- Liên hệ & Hộp thư Chat -->
                <a asp-controller="Cart" asp-action="Index" class="cart" title="Liên hệ & Hộp thư Chat">
                    💬 Liên hệ
                </a>
            </div>
        </div>

        <!-- NAVIGATION MENU -->
        <nav>
            <ul>
                <li><a asp-controller="Home" asp-action="Index">Trang chủ</a></li>
                <li><a asp-controller="Products" asp-action="PostItem">Đăng bán đồ cũ</a></li>
                <li><a asp-controller="Products" asp-action="MyListings">Tin của tôi</a></li>
                <li><a asp-controller="Orders" asp-action="MyOrders">Đơn hàng của tôi</a></li>
                <li><a asp-controller="Home" asp-action="Warranty">Chính sách bảo đảm</a></li>
            </ul>
        </nav>
    </header>

    <!-- MAIN CONTENT (FULL WIDTH - KHÔNG KHOẢNG TRẮNG 2 BÊN) -->
    <main style="width: 100%; margin: 0; padding: 0;">
        @RenderBody()
    </main>

    <!-- Toast Notification -->
    <div id="toast" class="toast">
        <i id="toast-icon" class="fas fa-check-circle"></i>
        <span id="toast-message">Thành công!</span>
    </div>

    <!-- FOOTER -->
    <footer>
        <div class="footer-container">
            <div class="footer-col">
                <h4>ThriftShop Secondhand</h4>
                <p>Nền tảng mua bán đồ cũ trực tuyến, thúc đẩy tái sử dụng và lối sống xanh bền vững.</p>
                <p style="margin-top: 8px; color: #cbd5e1;"><i class="fas fa-shield-alt text-warning mr-1" style="color: #fbbf24;"></i>Mọi tin rao đều được Ban Quản Trị kiểm duyệt chất lượng trước khi mở bán.</p>
            </div>
            <div class="footer-col">
                <h4>Danh Mục & Dịch Vụ</h4>
                <ul>
                    <li><a asp-controller="Products" asp-action="Index">Tất Cả Tin Bán Đồ Cũ</a></li>
                    <li><a asp-controller="Products" asp-action="PostItem">Đăng Bán Đồ Cũ Mới</a></li>
                    <li><a asp-controller="Products" asp-action="MyListings">Quản Lý Tin Của Tôi</a></li>
                    <li><a asp-controller="Orders" asp-action="MyOrders">Đơn Hàng Của Tôi</a></li>
                    <li><a asp-controller="Products" asp-action="Favorites">Tin Đã Yêu Thích</a></li>
                </ul>
            </div>
            <div class="footer-col">
                <h4>Hỗ trợ</h4>
                <p><i class="fas fa-shield-alt mr-1"></i> <a asp-controller="Home" asp-action="Warranty" style="color: #cbd5e1; text-decoration: none;">Chính Sách Bảo Đảm</a></p>
                <p><i class="fas fa-phone mr-1"></i> Hotline hỗ trợ: 1900 6868</p>
                <p><i class="fas fa-envelope mr-1"></i> lienhe@thriftshop.vn</p>
            </div>
        </div>
        <div class="footer-bottom">
            <p>&copy; 2026 ThriftShop</p>
        </div>
    </footer>

    <!-- Core Scripts (jQuery, Bootstrap, Data.js, Main.js, Transition.js) -->
    <script src="https://code.jquery.com/jquery-3.5.1.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@4.5.2/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/data.js" asp-append-version="true"></script>
    <script src="~/js/main.js" asp-append-version="true"></script>
    <script src="~/js/page-transition.js" asp-append-version="true"></script>
    <script>
        function showToast(message, type = 'success') {
            const toast = document.getElementById('toast');
            const toastMessage = document.getElementById('toast-message');
            const toastIcon = document.getElementById('toast-icon');
            if (!toast) return;

            toastMessage.textContent = message;
            toast.className = `toast toast-${type} show`;

            if (type === 'success') {
                toastIcon.className = 'fas fa-check-circle';
            } else {
                toastIcon.className = 'fas fa-exclamation-circle';
            }

            setTimeout(() => {
                toast.classList.remove('show');
            }, 3000);
        }

        // Cập nhật số lượng tin chờ duyệt trên Header
        $(document).ready(function() {
            if (typeof ThriftDB !== 'undefined') {
                const pending = ThriftDB.getPendingCount();
                $('#nav-pending-count').text(pending);
            }

            @if (TempData["SuccessMessage"] != null)
            {
                <text>
                showToast("@Html.Raw(TempData["SuccessMessage"])", "success");
                </text>
            }
            @if (TempData["ErrorMessage"] != null)
            {
                <text>
                showToast("@Html.Raw(TempData["ErrorMessage"])", "error");
                </text>
            }
            @if (TempData["InfoMessage"] != null)
            {
                <text>
                showToast("@Html.Raw(TempData["InfoMessage"])", "info");
                </text>
            }
        });
    </script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
