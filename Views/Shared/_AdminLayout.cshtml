<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>@ViewData["Title"] - Trang Quản Trị MyStore</title>
    <!-- Google Fonts (Be Vietnam Pro) -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Be+Vietnam+Pro:wght@400;500;600;700;800&display=swap" rel="stylesheet">
    <!-- Bootstrap 4.5.2 CSS -->
    <link rel="stylesheet" href="https://maxcdn.bootstrapcdn.com/bootstrap/4.5.2/css/bootstrap.min.css" />
    <!-- Font Awesome Icons -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" />
    <!-- Admin CSS -->
    <link rel="stylesheet" href="~/css/admin.css" asp-append-version="true" />
    <style>
        .admin-nav-bar {
            background-color: #212529;
            padding: 14px 0;
            margin-bottom: 25px;
            box-shadow: 0 2px 5px rgba(0,0,0,0.2);
        }

        .admin-nav-container {
            display: flex;
            align-items: center;
            justify-content: space-between;
        }

        .admin-brand {
            color: #ffffff !important;
            font-size: 22px;
            font-weight: bold;
            text-decoration: none !important;
            margin-right: 35px;
        }

        .admin-menu-list {
            display: flex;
            list-style: none;
            margin: 0;
            padding: 0;
            gap: 15px;
            align-items: center;
        }

        .admin-menu-list a {
            color: #ced4da !important;
            text-decoration: none !important;
            font-size: 16px;
            font-weight: 500;
            padding: 8px 12px;
            border-radius: 4px;
            transition: all 0.2s;
        }

        .admin-menu-list a:hover {
            color: #ffffff !important;
            background-color: #343a40;
        }

        .admin-link-client {
            color: #20c997 !important;
            text-decoration: none !important;
            font-weight: 600;
            padding: 8px 14px;
            border: 1px solid #20c997;
            border-radius: 4px;
            transition: all 0.2s;
        }

        .admin-link-client:hover {
            background-color: #20c997;
            color: #ffffff !important;
        }

        /* Banner & Styling theo biểu mẫu slide */
        h2.bg-success {
            background-color: #d8ebd2 !important;
            color: #2d572c !important;
            padding: 12px 18px !important;
            margin-top: 15px !important;
            margin-bottom: 20px !important;
            border-radius: 4px !important;
            font-size: 24px !important;
            font-weight: 600 !important;
            text-transform: uppercase !important;
        }

        th.bg-success, thead.table-success, thead th {
            background-color: #d8ebd2 !important;
            color: #2d572c !important;
            font-weight: bold !important;
        }

        table.bg-info {
            background-color: #eaf4fb !important;
        }

        .search-container {
            padding-top: 15px;
            display: flex;
            gap: 10px;
            justify-content: center;
            align-items: center;
            margin-bottom: 20px;
            flex-wrap: wrap;
        }

        .order-container {
            display: flex;
            gap: 10px;
            justify-content: center;
            align-items: center;
            margin-bottom: 20px;
            font-weight: 500;
        }

        footer {
            margin-top: 30px;
            padding: 20px 0;
            color: #495057;
        }

        footer h4 {
            font-size: 16px;
            margin-top: 10px;
            margin-bottom: 5px;
            font-weight: bold;
        }
    </style>
</head>
<body class="admin-body">
    <header class="admin-nav-bar">
        <div class="container admin-nav-container">
            <div style="display: flex; align-items: center;">
                <a asp-controller="Admin" asp-action="Index" class="admin-brand">My Store</a>
                <ul class="admin-menu-list">
                    <li><a asp-controller="Admin" asp-action="Index">Home</a></li>
                    <li><a asp-controller="Admin" asp-action="Categories">Danh mục</a></li>
                    <li><a asp-controller="Admin" asp-action="Products">Sản phẩm</a></li>
                    <li><a asp-controller="Admin" asp-action="ApproveProducts">Duyệt tin</a></li>
                    <li><a asp-controller="Admin" asp-action="Orders">Đơn hàng</a></li>
                    <li><a asp-controller="Admin" asp-action="Users">Khách hàng</a></li>
                    <li><a asp-controller="Admin" asp-action="Chat">Tin nhắn / Hỗ trợ</a></li>
                    <li><a asp-controller="Account" asp-action="Logout">Đăng xuất</a></li>
                </ul>
            </div>
            <div class="ms-auto d-flex align-items-center pe-3">
                <a href="/" target="_blank" class="btn btn-outline-success btn-sm" 
                   style="line-height: 1.5; padding: 5px 12px; font-size: 13px; font-weight: 500; border-radius: 4px; white-space: nowrap;">
                    Về trang chủ Web
                </a>
            </div>
        </div>
    </header>

    <main class="container body-content">
        @RenderBody()
        <hr />
        <footer class="mt-4 pb-4 text-muted">
            <p>&copy; @DateTime.Now.Year - ThriftShop Secondhand C2C</p>
            <h4 style="font-size: 16px; font-weight: bold; margin-top: 10px; margin-bottom: 5px;">Contact</h4>
            <p>Trần Nguyễn Anh Khoa</p>
        </footer>
    </main>

    <!-- Core Scripts -->
    <script src="https://ajax.googleapis.com/ajax/libs/jquery/3.5.1/jquery.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/popper.js/1.16.0/umd/popper.min.js"></script>
    <script src="https://maxcdn.bootstrapcdn.com/bootstrap/4.5.2/js/bootstrap.min.js"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
