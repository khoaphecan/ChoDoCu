@model ThriftShop.Models.Conversation
@{
    Layout = "_AdminLayout";
    ViewData["Title"] = "Chi Tiết Tin Nhắn & Trả Lời";
    var messages = ViewBag.Messages as List<ThriftShop.Models.ChatMessage> ?? new List<ThriftShop.Models.ChatMessage>();
    var adminIds = ViewBag.AdminIds as List<int> ?? new List<int> { ViewBag.AdminId != null ? (int)ViewBag.AdminId : 1 };
    int adminId = ViewBag.AdminId != null ? (int)ViewBag.AdminId : 1;
    bool isSupport = (Model.ProductId == null);
    var customer = adminIds.Contains(Model.BuyerId) ? Model.Seller : Model.Buyer;
    string customerName = customer?.FullName ?? customer?.Email ?? "Người dùng";
}

<h2 class="bg-success">CHI TIẾT PHIÊN HỖ TRỢ CSKH</h2>

@if (TempData["ErrorMessage"] != null)
{
    <div class="alert alert-danger alert-dismissible fade show mt-2" role="alert">
        @TempData["ErrorMessage"]
        <button type="button" class="close" data-dismiss="alert" aria-label="Close">&times;</button>
    </div>
}
@if (TempData["SuccessMessage"] != null)
{
    <div class="alert alert-success alert-dismissible fade show mt-2" role="alert">
        @TempData["SuccessMessage"]
        <button type="button" class="close" data-dismiss="alert" aria-label="Close">&times;</button>
    </div>
}

<!-- THÔNG TIN HỘI THOẠI -->
<div class="card mb-4 border">
    <div class="card-header font-weight-bold" style="background-color: #d8ebd2; color: #2d572c;">
        Thông Tin Phiên Hỗ Trợ CSKH #@Model.Id
    </div>
    <div class="card-body">
        <dl class="row mb-0">
            <dt class="col-sm-3 font-weight-bold">Khách hàng:</dt>
            <dd class="col-sm-9">@customerName (@(customer?.Email ?? "N/A"))</dd>

            <dt class="col-sm-3 font-weight-bold">Số điện thoại:</dt>
            <dd class="col-sm-9">@(string.IsNullOrWhiteSpace(customer?.Phone) ? "Chưa cung cấp" : customer.Phone)</dd>

            <dt class="col-sm-3 font-weight-bold">Kênh hỗ trợ:</dt>
            <dd class="col-sm-9">
                <span class="badge badge-primary">Hỗ Trợ Khách Hàng CSKH Trực Tiếp</span>
            </dd>

            <dt class="col-sm-3 font-weight-bold">Thời gian cập nhật:</dt>
            <dd class="col-sm-9">@Model.UpdatedAt.ToString("dd/MM/yyyy HH:mm")</dd>
        </dl>
    </div>
</div>

<!-- LỊCH SỬ TIN NHẮN DẠNG DANH SÁCH ĐƠN GIẢN -->
<div class="card mb-4 border">
    <div class="card-header font-weight-bold" style="background-color: #d8ebd2; color: #2d572c;">
        Lịch Sử Tin Nhắn (@messages.Count tin nhắn)
    </div>
    <div class="card-body p-0" style="max-height: 480px; overflow-y: auto;">
        @if (!messages.Any())
        {
            <div class="p-4 text-center text-muted">Chưa có tin nhắn nào trong hội thoại này.</div>
        }
        else
        {
            <ul class="list-group list-group-flush">
                @foreach (var m in messages)
                {
                    bool isAdmin = (adminIds.Contains(m.SenderId) || (m.SenderName != null && m.SenderName.Contains("Ban Quản Trị")));
                    string msgRaw = m.Message ?? "";

                    <li class="list-group-item @(isAdmin ? "bg-light" : "")">
                        <div class="d-flex justify-content-between align-items-center mb-1">
                            <div>
                                @if (isAdmin)
                                {
                                    <span class="badge badge-primary mr-1">Admin</span>
                                    <strong class="text-primary">Ban Quản Trị ThriftShop</strong>
                                }
                                else
                                {
                                    <span class="badge badge-secondary mr-1">Khách</span>
                                    <strong>@(m.SenderName ?? customerName)</strong>
                                }
                            </div>
                            <small class="text-muted">@m.SentAt.ToString("dd/MM/yyyy HH:mm")</small>
                        </div>
                        <div class="mt-1" style="font-size: 14.5px; line-height: 1.5;">
                            @if (msgRaw.StartsWith("[IMG]:"))
                            {
                                var imgUrl = msgRaw.Replace("[IMG]:", "").Trim();
                                <a href="@imgUrl" target="_blank">
                                    <img src="@imgUrl" style="max-width: 220px; max-height: 160px; border-radius: 6px; display: block; margin: 4px 0;" alt="Ảnh đính kèm" />
                                </a>
                            }
                            else if (msgRaw.StartsWith("[VIDEO]:"))
                            {
                                var videoUrl = msgRaw.Replace("[VIDEO]:", "").Trim();
                                <video controls style="max-width: 260px; max-height: 160px; border-radius: 6px; display: block; margin: 4px 0;">
                                    <source src="@videoUrl" type="video/mp4" />
                                </video>
                            }
                            else
                            {
                                @msgRaw
                            }
                        </div>
                    </li>
                }
            </ul>
        }
    </div>
</div>

<!-- KHUNG TRẢ LỜI CỦA ADMIN -->
<div class="card mb-4 border">
    <div class="card-header font-weight-bold" style="background-color: #d8ebd2; color: #2d572c;">
        Gửi Phản Hồi Từ Ban Quản Trị
    </div>
    <div class="card-body">
        <form asp-action="SendAdminMessage" method="post">
            @Html.AntiForgeryToken()
            <input type="hidden" name="conversationId" value="@Model.Id" />
            <div class="form-group">
                <textarea name="message" class="form-control" rows="3" placeholder="Nhập câu trả lời từ Ban Quản Trị gửi cho khách hàng..." required></textarea>
            </div>
            <div class="d-flex justify-content-between align-items-center">
                <a asp-action="Chat" class="btn btn-secondary">Quay lại danh sách</a>
                <button type="submit" class="btn btn-primary px-4 font-weight-bold">
                    <i class="fas fa-paper-plane mr-1"></i> Gửi phản hồi
                </button>
            </div>
        </form>
    </div>
</div>
