@model IEnumerable<ThriftShop.Models.Category>
@{
    Layout = "_AdminLayout";
    ViewData["Title"] = "Quản Lý Danh Mục";
}

<h2 class="bg-success">DANH SÁCH DANH MỤC</h2>

@if (TempData["ErrorMessage"] != null)
{
    <div class="alert alert-danger alert-dismissible fade show mt-2" role="alert">
        @TempData["ErrorMessage"]
        <button type="button" class="close" data-dismiss="alert" aria-label="Close">&times;</button>
    </div>
}
@if (TempData["SuccessMessage"] != null)
{
    <div class="alert alert-success alert-dismissible fade show mt-2" role="alert">
        @TempData["SuccessMessage"]
        <button type="button" class="close" data-dismiss="alert" aria-label="Close">&times;</button>
    </div>
}

<p class="mb-3">
    <a asp-controller="Admin" asp-action="CreateCategory" class="btn btn-primary">Thêm mới</a>
</p>

<table class="table table-bordered table-hover">
    <thead class="table-success" style="background-color: #d8ebd2;">
        <tr>
            <th class="bg-success text-center" style="width: 80px;">MÃ</th>
            <th class="bg-success">TÊN DANH MỤC</th>
            <th class="bg-success">MÔ TẢ</th>
            <th class="bg-success text-center" style="width: 170px;">THAO TÁC</th>
        </tr>
    </thead>
    <tbody>
        @if (Model != null && Model.Any())
        {
            foreach (var item in Model)
            {
                <tr>
                    <td class="text-center font-weight-bold">#@item.Id</td>
                    <td><strong>@item.Name</strong></td>
                    <td>@(string.IsNullOrEmpty(item.Description) ? "Không có mô tả" : item.Description)</td>
                    <td class="text-center text-nowrap">
                        <a asp-controller="Admin" asp-action="EditCategory" asp-route-id="@item.Id" class="btn btn-primary btn-sm mr-1">Sửa</a>
                        <a asp-controller="Admin" asp-action="DeleteCategory" asp-route-id="@item.Id" class="btn btn-danger btn-sm">Xóa</a>
                    </td>
                </tr>
            }
        }
        else
        {
            <tr>
                <td colspan="4" class="text-center py-4 text-muted">Chưa có danh mục nào trong hệ thống!</td>
            </tr>
        }
    </tbody>
</table>
