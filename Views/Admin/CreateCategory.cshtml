@model ThriftShop.Models.Category
@{
    Layout = "_AdminLayout";
    ViewData["Title"] = "Thêm Danh Mục Mới";
}

<h2 class="bg-success">THÊM DANH MỤC MỚI</h2>

<div class="card p-4 border" style="max-width: 700px;">
    <form asp-controller="Admin" asp-action="CreateCategory" method="post">
        @Html.AntiForgeryToken()
        <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

        <div class="form-group row">
            <label asp-for="Name" class="col-sm-3 col-form-label font-weight-bold">Tên Danh Mục *</label>
            <div class="col-sm-9">
                <input asp-for="Name" class="form-control" placeholder="Ví dụ: Đồ gốm & Sưu tầm" required />
                <span asp-validation-for="Name" class="text-danger"></span>
            </div>
        </div>

        <div class="form-group row">
            <label asp-for="Description" class="col-sm-3 col-form-label font-weight-bold">Mô Tả</label>
            <div class="col-sm-9">
                <textarea asp-for="Description" class="form-control" rows="3" placeholder="Mô tả các mặt hàng trong danh mục này..."></textarea>
                <span asp-validation-for="Description" class="text-danger"></span>
            </div>
        </div>

        <div class="form-group row mt-4">
            <div class="col-sm-9 offset-sm-3">
                <input type="submit" value="Lưu" class="btn btn-primary" />
                <a asp-controller="Admin" asp-action="Categories" class="btn btn-primary ml-2">
                    Quay lại danh sách
                </a>
            </div>
        </div>
    </form>
</div>
