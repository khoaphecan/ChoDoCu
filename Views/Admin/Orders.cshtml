@model IEnumerable<ThriftShop.Models.Order>
@{
    Layout = "_AdminLayout";
    ViewData["Title"] = "Danh Sách Đơn Hàng";
}

<h2 class="bg-success">DANH SÁCH ĐƠN HÀNG</h2>

@if (TempData["ErrorMessage"] != null)
{
    <div class="alert alert-danger alert-dismissible fade show mt-2" role="alert">
        @TempData["ErrorMessage"]
        <button type="button" class="close" data-dismiss="alert" aria-label="Close">&times;</button>
    </div>
}
@if (TempData["SuccessMessage"] != null)
{
    <div class="alert alert-success alert-dismissible fade show mt-2" role="alert">
        @TempData["SuccessMessage"]
        <button type="button" class="close" data-dismiss="alert" aria-label="Close">&times;</button>
    </div>
}

<table class="table table-bordered table-hover">
    <thead class="table-success" style="background-color: #d8ebd2;">
        <tr>
            <th class="bg-success text-center" style="width: 110px;">MÃ ĐƠN</th>
            <th class="bg-success">KHÁCH HÀNG</th>
            <th class="bg-success" style="width: 130px;">SỐ ĐIỆN THOẠI</th>
            <th class="bg-success" style="width: 160px;">NGÀY ĐẶT</th>
            <th class="bg-success" style="width: 130px;">TỔNG TIỀN</th>
            <th class="bg-success text-center" style="width: 140px;">TRẠNG THÁI</th>
            <th class="bg-success">ĐỊA CHỈ GIAO</th>
            <th class="bg-success text-center" style="width: 160px;">THAO TÁC</th>
        </tr>
    </thead>
    <tbody>
        @if (Model != null && Model.Any())
        {
            foreach (var item in Model)
            {
                var st = item.Status ?? "pending";
                string bClass;
                string sDisplay;

                if (st == "pending" || st.Equals("Đang xác nhận", StringComparison.OrdinalIgnoreCase))
                {
                    bClass = "bg-warning text-dark";
                    sDisplay = "Đang xác nhận";
                }
                else if (st == "confirmed" || st == "processing" || st.Equals("Đã xác nhận", StringComparison.OrdinalIgnoreCase))
                {
                    bClass = "bg-info text-dark";
                    sDisplay = "Đã xác nhận";
                }
                else if (st == "shipping" || st.Equals("Đang vận chuyển", StringComparison.OrdinalIgnoreCase))
                {
                    bClass = "bg-primary text-white";
                    sDisplay = "Đang vận chuyển";
                }
                else if (st == "delivered" || st.Equals("Đã giao", StringComparison.OrdinalIgnoreCase))
                {
                    bClass = "bg-success text-white";
                    sDisplay = "Đã giao";
                }
                else
                {
                    bClass = "bg-secondary text-white";
                    sDisplay = st;
                }

                <tr>
                    <td class="text-center font-weight-bold">@item.OrderCode</td>
                    <td>@item.CustName</td>
                    <td>@item.CustPhone</td>
                    <td>@item.OrderDate.ToString("dd/MM/yyyy HH:mm")</td>
                    <td class="font-weight-bold text-danger">@item.TotalAmount.ToString("N0") đ</td>
                    <td class="text-center">
                        <span class="badge @bClass px-2 py-1 font-weight-bold">@sDisplay</span>
                    </td>
                    <td>@item.CustAddress</td>
                    <td class="text-center text-nowrap">
                        <a asp-action="OrderDetails" asp-route-id="@item.Id" class="btn btn-primary btn-sm">Chi tiết</a>
                        <a asp-action="DeleteOrder" asp-route-id="@item.Id" class="btn btn-danger btn-sm">Xóa</a>
                    </td>
                </tr>
            }
        }
        else
        {
            <tr>
                <td colspan="8" class="text-center text-muted py-4">Chưa có đơn hàng nào trong hệ thống.</td>
            </tr>
        }
    </tbody>
</table>
