@model IEnumerable<ThriftShop.Models.Product>
@{
    Layout = "_AdminLayout";
    ViewData["Title"] = "Danh Sách Sản Phẩm";
    var categories = ViewBag.Categories as IEnumerable<ThriftShop.Models.Category> ?? new List<ThriftShop.Models.Category>();
}

@if (TempData["Error"] != null || TempData["ErrorMessage"] != null)
{
    <div class="alert alert-danger alert-dismissible fade show mt-2" role="alert">
        @Html.Raw(TempData["Error"] ?? TempData["ErrorMessage"])
        <button type="button" class="close" data-dismiss="alert" aria-label="Close">&times;</button>
    </div>
}
@if (TempData["Success"] != null || TempData["SuccessMessage"] != null)
{
    <div class="alert alert-success alert-dismissible fade show mt-2" role="alert">
        @Html.Raw(TempData["Success"] ?? TempData["SuccessMessage"])
        <button type="button" class="close" data-dismiss="alert" aria-label="Close">&times;</button>
    </div>
}

<!-- Form tìm kiếm chuẩn MyStore -->
<form method="get" asp-action="Products">
    <div class="form-group search-container">
        <select name="categoryId" class="form-control" style="max-width: 200px;">
            <option value="">Tất cả danh mục</option>
            @foreach (var cat in categories)
            {
                <!option value="@cat.Id" @(ViewBag.CategoryId == cat.Id ? "selected" : "")>@cat.Name</!option>
            }
        </select>

        <input type="text" name="searchTerm" value="@ViewBag.SearchTerm" class="form-control" placeholder="Nhập tên, mô tả..." style="max-width: 300px;" />

        <input type="number" name="minPrice" value="@ViewBag.MinPrice" class="form-control" placeholder="Giá tối thiểu" style="max-width: 150px;" />

        <input type="number" name="maxPrice" value="@ViewBag.MaxPrice" class="form-control" placeholder="Giá tối đa" style="max-width: 150px;" />

        <button type="submit" class="btn btn-primary">Tìm kiếm</button>
    </div>

    <!-- Tùy chọn sắp xếp LINQ -->
    <div class="form-group order-container">
        <span>Sắp xếp theo:</span>
        <a asp-action="Products" asp-route-sortOrder="name_asc" asp-route-searchTerm="@ViewBag.SearchTerm" asp-route-minPrice="@ViewBag.MinPrice" asp-route-maxPrice="@ViewBag.MaxPrice" asp-route-categoryId="@ViewBag.CategoryId">Tên tăng dần</a>
        |
        <a asp-action="Products" asp-route-sortOrder="name_desc" asp-route-searchTerm="@ViewBag.SearchTerm" asp-route-minPrice="@ViewBag.MinPrice" asp-route-maxPrice="@ViewBag.MaxPrice" asp-route-categoryId="@ViewBag.CategoryId">Tên giảm dần</a>
        |
        <a asp-action="Products" asp-route-sortOrder="price_asc" asp-route-searchTerm="@ViewBag.SearchTerm" asp-route-minPrice="@ViewBag.MinPrice" asp-route-maxPrice="@ViewBag.MaxPrice" asp-route-categoryId="@ViewBag.CategoryId">Giá tăng dần</a>
        |
        <a asp-action="Products" asp-route-sortOrder="price_desc" asp-route-searchTerm="@ViewBag.SearchTerm" asp-route-minPrice="@ViewBag.MinPrice" asp-route-maxPrice="@ViewBag.MaxPrice" asp-route-categoryId="@ViewBag.CategoryId">Giá giảm dần</a>
    </div>
</form>

<!-- Hiển thị danh sách sản phẩm -->
@if (Model != null && Model.Any())
{
    <h2 class="bg-success">DANH SÁCH SẢN PHẨM</h2>

    <table class="table bg-info table-bordered table-hover">
        <thead>
            <tr>
                <th class="bg-success text-center" style="width: 110px;">Hình ảnh</th>
                <th class="bg-success">Tên sản phẩm</th>
                <th class="bg-success" style="width: 140px;">Đơn giá</th>
                <th class="bg-success" style="width: 160px;">Danh mục</th>
                <th class="bg-success text-center" style="width: 140px;">TRẠNG THÁI</th>
                <th class="bg-success text-center" style="width: 220px;">THAO TÁC</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var product in Model)
            {
                <tr>
                    <td class="text-center p-2 align-middle">
                        <img src="@product.DisplayImage" 
                             style="height: 80px; width: 80px; object-fit: cover; border-radius: 4px;" 
                             alt="@product.Name"
                             onerror="this.onerror=null; this.src='https://images.unsplash.com/photo-1523275335684-37898b6baf30?w=100';" />
                    </td>
                    <td class="align-middle">
                        @product.Name
                    </td>
                    <td class="align-middle">@product.Price.ToString("N0") đ</td>
                    <td class="align-middle">@(product.Category?.Name ?? product.CategoryName)</td>
                    <td class="text-center align-middle">
                        @if (product.IsSold || product.Status == "sold" || product.Stock <= 0)
                        {
                            <span class="badge bg-secondary" style="background-color: #64748b; color: #fff; padding: 6px 12px; font-size: 12px; border-radius: 12px; font-weight: 600;">Đã bán</span>
                        }
                        else if (product.Status == "pending")
                        {
                            <span class="badge bg-warning text-dark" style="background-color: #f59e0b; color: #1e293b; padding: 6px 12px; font-size: 12px; border-radius: 12px; font-weight: 600;">Chờ duyệt</span>
                        }
                        else if (product.Status == "rejected")
                        {
                            <span class="badge bg-danger" style="background-color: #ef4444; color: #fff; padding: 6px 12px; font-size: 12px; border-radius: 12px; font-weight: 600;">Bị từ chối</span>
                        }
                        else
                        {
                            <span class="badge bg-success" style="background-color: #10b981; color: #fff; padding: 6px 12px; font-size: 12px; border-radius: 12px; font-weight: 600;">Đang bán</span>
                        }
                    </td>
                    <td class="text-center text-nowrap align-middle">
                        @if (!product.IsSold && product.Status != "sold" && product.Stock > 0)
                        {
                            <a asp-action="EditProduct" asp-route-id="@product.Id" class="btn btn-primary btn-sm">Sửa</a>
                        }
                        <a asp-action="ProductDetails" asp-route-id="@product.Id" class="btn btn-info btn-sm text-white">Chi tiết</a>
                        <a asp-action="DeleteProduct" asp-route-id="@product.Id" class="btn btn-danger btn-sm" onclick="return confirm('Bạn có chắc muốn xóa sản phẩm này?');">Xóa</a>
                    </td>
                </tr>
            }
        </tbody>
    </table>
}
else
{
    <div class="alert alert-warning">Không tìm được sản phẩm nào phù hợp.</div>
}

<div class="form-group mt-3">
    <div class="col-md-offset-8 col-md-4">
        <a asp-action="CreateProduct" class="btn btn-primary">Thêm mới</a>
    </div>
</div>
