@model IEnumerable<ThriftShop.Models.User>
@{
    Layout = "_AdminLayout";
    ViewData["Title"] = "Danh Sách Khách Hàng & Tài Khoản";
    int currentAdminId = ViewBag.CurrentAdminId != null ? (int)ViewBag.CurrentAdminId : 1;
}

<h2 class="bg-success">DANH SÁCH KHÁCH HÀNG & TÀI KHOẢN</h2>

@if (TempData["ErrorMessage"] != null)
{
    <div class="alert alert-danger alert-dismissible fade show mt-2" role="alert">
        @TempData["ErrorMessage"]
        <button type="button" class="close" data-dismiss="alert" aria-label="Close">&times;</button>
    </div>
}
@if (TempData["SuccessMessage"] != null)
{
    <div class="alert alert-success alert-dismissible fade show mt-2" role="alert">
        @TempData["SuccessMessage"]
        <button type="button" class="close" data-dismiss="alert" aria-label="Close">&times;</button>
    </div>
}

<div class="mb-3">
    <a asp-action="CreateUser" class="btn btn-primary">
        <i class="fas fa-user-plus mr-1"></i> Thêm tài khoản mới
    </a>
</div>

<table class="table table-bordered table-hover">
    <thead class="table-success" style="background-color: #d8ebd2;">
        <tr>
            <th class="bg-success text-center" style="width: 80px;">MÃ ID</th>
            <th class="bg-success">HỌ VÀ TÊN</th>
            <th class="bg-success">EMAIL</th>
            <th class="bg-success" style="width: 140px;">SỐ ĐIỆN THOẠI</th>
            <th class="bg-success">ĐỊA CHỈ</th>
            <th class="bg-success text-center" style="width: 140px;">VAI TRÒ</th>
            <th class="bg-success text-center" style="width: 200px;">THAO TÁC</th>
        </tr>
    </thead>
    <tbody>
        @if (Model != null && Model.Any())
        {
            foreach (var item in Model)
            {
                <tr>
                    <td class="text-center font-weight-bold">#@item.Id</td>
                    <td>@item.FullName</td>
                    <td>@item.Email</td>
                    <td>@(string.IsNullOrEmpty(item.Phone) ? "---" : item.Phone)</td>
                    <td>@(string.IsNullOrEmpty(item.Address) ? "Chưa cập nhật" : item.Address)</td>
                    <td class="text-center font-weight-bold">
                        @if (item.Role?.ToLower() == "admin")
                        {
                            <span class="badge badge-primary px-2 py-1">Quản trị viên</span>
                        }
                        else
                        {
                            <span class="badge badge-secondary px-2 py-1">Khách hàng</span>
                        }
                    </td>
                    <td class="text-center">
                        <div class="d-flex justify-content-center align-items-center" style="gap: 5px;">
                            <a asp-action="UserDetails" asp-route-id="@item.Id" class="btn btn-info btn-sm text-white" style="padding: 3px 8px; font-size: 13px;">Chi tiết</a>
                            <a asp-action="EditUser" asp-route-id="@item.Id" class="btn btn-primary btn-sm" style="padding: 3px 8px; font-size: 13px;">Sửa</a>
                            @if (item.Role?.ToLower() != "admin" || item.Id != currentAdminId)
                            {
                                <form asp-action="DeleteUser" asp-route-id="@item.Id" method="post" class="d-inline mb-0" onsubmit="return confirm('Bạn có chắc muốn xóa tài khoản này?');">
                                    @Html.AntiForgeryToken()
                                    <button type="submit" class="btn btn-danger btn-sm" style="padding: 3px 8px; font-size: 13px;">Xóa</button>
                                </form>
                            }
                        </div>
                    </td>
                </tr>
            }
        }
        else
        {
            <tr>
                <td colspan="7" class="text-center text-muted py-4">Chưa có người dùng nào trong hệ thống.</td>
            </tr>
        }
    </tbody>
</table>
