@model ThriftShop.Models.User
@{
    Layout = "_AdminLayout";
    ViewData["Title"] = "Chỉnh Sửa Thông Tin Tài Khoản #" + Model.Id;
}

<h2 class="bg-success">CHỈNH SỬA TÀI KHOẢN #@Model.Id</h2>

<div class="card p-4 border" style="max-width: 750px;">
    <form asp-controller="Admin" asp-action="EditUser" asp-route-id="@Model.Id" method="post">
        @Html.AntiForgeryToken()
        <div asp-validation-summary="ModelOnly" class="text-danger mb-3 font-weight-bold"></div>

        <div class="form-group row">
            <label asp-for="FullName" class="col-sm-3 col-form-label font-weight-bold">Họ và Tên *</label>
            <div class="col-sm-9">
                <input asp-for="FullName" class="form-control" required />
                <span asp-validation-for="FullName" class="text-danger"></span>
            </div>
        </div>

        <div class="form-group row">
            <label asp-for="Email" class="col-sm-3 col-form-label font-weight-bold">Email Đăng Nhập *</label>
            <div class="col-sm-9">
                <input asp-for="Email" type="email" class="form-control" required />
                <span asp-validation-for="Email" class="text-danger"></span>
            </div>
        </div>

        <div class="form-group row">
            <label class="col-sm-3 col-form-label font-weight-bold">Đổi Mật Khẩu</label>
            <div class="col-sm-9">
                <input name="newPassword" type="password" class="form-control" placeholder="Để trống nếu muốn giữ nguyên mật khẩu cũ" />
                <span class="text-muted small">Chỉ nhập khi muốn thay đổi mật khẩu của tài khoản này (tối thiểu 4 ký tự).</span>
            </div>
        </div>

        <div class="form-group row">
            <label asp-for="Phone" class="col-sm-3 col-form-label font-weight-bold">Số Điện Thoại</label>
            <div class="col-sm-9">
                <input asp-for="Phone" class="form-control" />
                <span asp-validation-for="Phone" class="text-danger"></span>
            </div>
        </div>

        <div class="form-group row">
            <label asp-for="Address" class="col-sm-3 col-form-label font-weight-bold">Địa Chỉ</label>
            <div class="col-sm-9">
                <input asp-for="Address" class="form-control" />
                <span asp-validation-for="Address" class="text-danger"></span>
            </div>
        </div>

        <div class="form-group row">
            <label asp-for="Role" class="col-sm-3 col-form-label font-weight-bold">Vai Trò *</label>
            <div class="col-sm-9">
                <select asp-for="Role" class="form-control custom-select">
                    <option value="customer" selected="@(Model.Role?.ToLower() == "customer")">Khách hàng (Customer)</option>
                    <option value="admin" selected="@(Model.Role?.ToLower() == "admin")">Quản trị viên (Admin)</option>
                </select>
                <span asp-validation-for="Role" class="text-danger"></span>
            </div>
        </div>

        <div class="form-group row mt-4">
            <div class="col-sm-9 offset-sm-3">
                <button type="submit" class="btn btn-primary font-weight-bold px-4">
                    <i class="fas fa-save mr-1"></i> Lưu thông tin
                </button>
                <a asp-action="Users" class="btn btn-secondary ml-2">
                    Quay lại danh sách
                </a>
            </div>
        </div>
    </form>
</div>
