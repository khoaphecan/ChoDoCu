@model ThriftShop.Models.Order
@{
    Layout = "_AdminLayout";
    ViewData["Title"] = "Chi Tiết Đơn Hàng";
    var statusLower = (Model.Status ?? "pending").ToLower();
}

<h2 class="bg-success">CHI TIẾT ĐƠN HÀNG #@Model.Id (@Model.OrderCode)</h2>

@if (TempData["ErrorMessage"] != null)
{
    <div class="alert alert-danger alert-dismissible fade show mt-2" role="alert">
        @TempData["ErrorMessage"]
        <button type="button" class="close" data-dismiss="alert" aria-label="Close">&times;</button>
    </div>
}
@if (TempData["SuccessMessage"] != null)
{
    <div class="alert alert-success alert-dismissible fade show mt-2" role="alert">
        @TempData["SuccessMessage"]
        <button type="button" class="close" data-dismiss="alert" aria-label="Close">&times;</button>
    </div>
}

<div class="card mb-4 border">
    <div class="card-header bg-info font-weight-bold" style="background-color: #d8ebd2 !important; color: #2d572c;">
        Thông Tin Đơn Hàng
    </div>
    <div class="card-body">
        <dl class="row mb-0">
            <dt class="col-sm-3 font-weight-bold">Khách hàng:</dt>
            <dd class="col-sm-9">@Model.CustName</dd>

            <dt class="col-sm-3 font-weight-bold">Số điện thoại:</dt>
            <dd class="col-sm-9">@Model.CustPhone</dd>

            <dt class="col-sm-3 font-weight-bold">Email:</dt>
            <dd class="col-sm-9">@(string.IsNullOrEmpty(Model.CustEmail) ? "N/A" : Model.CustEmail)</dd>

            <dt class="col-sm-3 font-weight-bold">Ngày đặt hàng:</dt>
            <dd class="col-sm-9">@Model.OrderDate.ToString("dd/MM/yyyy HH:mm")</dd>

            <dt class="col-sm-3 font-weight-bold">Địa chỉ giao hàng:</dt>
            <dd class="col-sm-9">@Model.CustAddress</dd>

            <dt class="col-sm-3 font-weight-bold">Phương thức thanh toán:</dt>
            <dd class="col-sm-9">@Model.PaymentMethod</dd>

            <dt class="col-sm-3 font-weight-bold">Phương thức giao nhận:</dt>
            <dd class="col-sm-9">@(Model.ShippingMethod ?? "Giao hàng bưu tá / Đồng kiểm COD")</dd>

            <dt class="col-sm-3 font-weight-bold">Trạng thái:</dt>
            <dd class="col-sm-9">
                <form asp-action="UpdateOrderStatus" method="post" class="d-flex align-items-center gap-2" style="max-width: 450px;">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="orderId" value="@Model.Id" />
                    <select name="newStatus" class="form-select form-select-sm" style="width: auto;">
                        <option value="Đang xác nhận" selected="@(Model.Status == "pending" || Model.Status == "Đang xác nhận")">Đang xác nhận</option>
                        <option value="Đã xác nhận" selected="@(Model.Status == "confirmed" || Model.Status == "Đã xác nhận")">Đã xác nhận</option>
                        <option value="Đang vận chuyển" selected="@(Model.Status == "shipping" || Model.Status == "Đang vận chuyển")">Đang vận chuyển</option>
                        <option value="Đã giao" selected="@(Model.Status == "delivered" || Model.Status == "Đã giao")">Đã giao</option>
                    </select>
                    <button type="submit" class="btn btn-primary btn-sm">Cập nhật trạng thái</button>
                </form>
            </dd>

            <dt class="col-sm-3 font-weight-bold">Tổng tiền thanh toán:</dt>
            <dd class="col-sm-9 font-weight-bold text-danger" style="font-size: 18px;">@Model.TotalAmount.ToString("N0") đ</dd>
        </dl>
    </div>
</div>

<h3 style="color: #2d572c;" class="mb-3">DANH SÁCH MẶT HÀNG TRONG ĐƠN</h3>
<table class="table table-bordered">
    <thead class="table-success" style="background-color: #d8ebd2;">
        <tr>
            <th class="bg-success">Sản phẩm</th>
            <th class="bg-success text-center" style="width: 100px;">Số lượng</th>
            <th class="bg-success" style="width: 150px;">Đơn giá</th>
            <th class="bg-success" style="width: 150px;">Thành tiền</th>
        </tr>
    </thead>
    <tbody>
        @if (Model.OrderItems != null && Model.OrderItems.Any())
        {
            foreach (var detail in Model.OrderItems)
            {
                <tr>
                    <td>
                        <div class="d-flex align-items-center" style="gap: 12px;">
                            <img src="@(string.IsNullOrEmpty(detail.Image) ? (detail.Product?.Image ?? "https://images.unsplash.com/photo-1523275335684-37898b6baf30?w=600") : detail.Image)" 
                                 alt="@detail.ProductName" 
                                 style="width: 52px; height: 52px; object-fit: cover; border-radius: 6px; border: 1px solid #ced4da; flex-shrink: 0;" />
                            <div>
                                <div>
                                    <a href="/Products/Details/@detail.ProductId" target="_blank" class="font-weight-bold text-dark text-decoration-none" style="font-size: 14.5px;">
                                        @detail.ProductName <i class="fas fa-external-link-alt text-muted" style="font-size: 11px;"></i>
                                    </a>
                                    @if (detail.Product != null && (detail.Product.IsSold || detail.Product.Deleted || (detail.Product.Status != null && detail.Product.Status.ToLower() == "sold")))
                                    {
                                        <span class="badge bg-secondary text-white ms-1" style="font-size: 11px; padding: 2px 6px;">Đã bán</span>
                                    }
                                </div>
                                @{
                                    var sellerName = detail.Product?.Seller?.FullName ?? detail.Product?.SellerName;
                                    var sellerPhone = detail.Product?.Seller?.Phone ?? detail.Product?.SellerPhone;
                                }
                                @if (!string.IsNullOrWhiteSpace(sellerName) || !string.IsNullOrWhiteSpace(sellerPhone))
                                {
                                    <div class="small text-muted mt-1">
                                        <i class="fas fa-user mr-1"></i> Người bán: <strong>@(sellerName ?? "Chủ tin đăng")</strong>
                                        @if (!string.IsNullOrWhiteSpace(sellerPhone))
                                        {
                                            <span class="ms-2"><i class="fas fa-phone-alt mr-1"></i> @sellerPhone</span>
                                        }
                                    </div>
                                }
                            </div>
                        </div>
                    </td>
                    <td class="text-center align-middle font-weight-bold">@detail.Quantity</td>
                    <td class="align-middle">@detail.Price.ToString("N0") đ</td>
                    <td class="align-middle font-weight-bold text-danger">@((detail.Quantity * detail.Price).ToString("N0")) đ</td>
                </tr>
            }
        }
        else
        {
            <tr>
                <td colspan="4" class="text-center text-muted">Không có chi tiết mặt hàng</td>
            </tr>
        }
    </tbody>
</table>

<div class="mt-3">
    <a asp-action="Orders" class="btn btn-primary">Quay lại danh sách đơn hàng</a>
</div>
