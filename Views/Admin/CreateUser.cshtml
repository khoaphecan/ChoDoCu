@model ThriftShop.Models.User
@{
    Layout = "_AdminLayout";
    ViewData["Title"] = "Thêm Tài Khoản Mới";
}

<h2 class="bg-success">THÊM TÀI KHOẢN MỚI</h2>

<div class="card p-4 border" style="max-width: 750px;">
    <form asp-controller="Admin" asp-action="CreateUser" method="post">
        @Html.AntiForgeryToken()
        <div asp-validation-summary="ModelOnly" class="text-danger mb-3 font-weight-bold"></div>

        <div class="form-group row">
            <label asp-for="FullName" class="col-sm-3 col-form-label font-weight-bold">Họ và Tên *</label>
            <div class="col-sm-9">
                <input asp-for="FullName" class="form-control" placeholder="Ví dụ: Nguyễn Văn A" required />
                <span asp-validation-for="FullName" class="text-danger"></span>
            </div>
        </div>

        <div class="form-group row">
            <label asp-for="Email" class="col-sm-3 col-form-label font-weight-bold">Email Đăng Nhập *</label>
            <div class="col-sm-9">
                <input asp-for="Email" type="email" class="form-control" placeholder="email@domain.com" required />
                <span asp-validation-for="Email" class="text-danger"></span>
            </div>
        </div>

        <div class="form-group row">
            <label class="col-sm-3 col-form-label font-weight-bold">Mật Khẩu *</label>
            <div class="col-sm-9">
                <input name="password" type="password" class="form-control" placeholder="Tối thiểu 4 ký tự" required />
                <span class="text-muted small">Mật khẩu dùng để đăng nhập vào hệ thống.</span>
            </div>
        </div>

        <div class="form-group row">
            <label asp-for="Phone" class="col-sm-3 col-form-label font-weight-bold">Số Điện Thoại</label>
            <div class="col-sm-9">
                <input asp-for="Phone" class="form-control" placeholder="Ví dụ: 0901234567" />
                <span asp-validation-for="Phone" class="text-danger"></span>
            </div>
        </div>

        <div class="form-group row">
            <label asp-for="Address" class="col-sm-3 col-form-label font-weight-bold">Địa Chỉ</label>
            <div class="col-sm-9">
                <input asp-for="Address" class="form-control" placeholder="Ví dụ: Quận 1, TP. Hồ Chí Minh" />
                <span asp-validation-for="Address" class="text-danger"></span>
            </div>
        </div>

        <div class="form-group row">
            <label asp-for="Role" class="col-sm-3 col-form-label font-weight-bold">Vai Trò *</label>
            <div class="col-sm-9">
                <select asp-for="Role" class="form-control custom-select">
                    <option value="customer">Khách hàng (Customer)</option>
                    <option value="admin">Quản trị viên (Admin)</option>
                </select>
                <span asp-validation-for="Role" class="text-danger"></span>
            </div>
        </div>

        <div class="form-group row mt-4">
            <div class="col-sm-9 offset-sm-3">
                <button type="submit" class="btn btn-primary font-weight-bold px-4">
                    <i class="fas fa-save mr-1"></i> Lưu thông tin
                </button>
                <a asp-action="Users" class="btn btn-secondary ml-2">
                    Quay lại danh sách
                </a>
            </div>
        </div>
    </form>
</div>
